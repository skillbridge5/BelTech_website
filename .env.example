# Production API (include /api suffix — matches backend mounts like /api/analytics)
VITE_API_BASE=https://api.beltechsolns.et/api
# Canonical marketing site URL (no trailing slash). Used for meta tags, JSON-LD, and sitemap consistency.
VITE_SITE_URL=https://beltechsolns.et
# Google Search Console verification token (written into prerendered HTML by npm run build)
VITE_GSC_VERIFICATION=
# Optional GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
VITE_GA4_ID=
