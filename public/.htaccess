# ----------------------------------------------------------------------
# BelTech Solutions - cPanel / Apache Configuration
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (Optional - uncomment if your SSL certificate is installed)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Prevent direct access to .env or hidden files
  <FilesMatch "^\.">
    Order allow,deny
    Deny from all
  </FilesMatch>

  # 3. Single Page Application (SPA) routing:
  # Pass real files and directories straight through
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs to index.html for React Router
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Caching & Performance
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration: 1 hour
  ExpiresDefault "access plus 1 hour"

  # HTML: never cache index.html long-term so updates appear instantly
  ExpiresByType text/html "access plus 0 seconds"

  # Assets with hashed filenames (Vite output in /assets/): 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images and fonts: 1 month
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Brotli Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
